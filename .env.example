# Optional local access token. When set, it protects /api/* and can also be
# used as a Bearer token for /v1/* requests.
GPT_PROXY_ACCESS_TOKEN=

# Optional passphrase used to encrypt API keys inside config.json.
GPT_PROXY_CONFIG_SECRET=

# Optional custom runtime file locations. Leave commented for the local default
# ./config.json and ./state.json.
# GPT_PROXY_CONFIG=./config.json
# GPT_PROXY_STATE=./state.json

# Local rate-limit and request safety knobs.
GPT_PROXY_RATE_LIMIT_PER_MINUTE=0
GPT_PROXY_MAX_REQUEST_BYTES=2097152
GPT_PROXY_KEY_COOLDOWN_SECONDS=60

# Logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
